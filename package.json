{
  "name": "personal-voice-assistance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "pnpm --silent --filter @pva/assistant start",
    "serve": "pnpm --silent --filter @pva/web build && (pnpm --silent --filter @pva/node bundle || echo \"voice node bundle not built: /node/* answers 404\") && pnpm --silent --filter @pva/assistant start serve",
    "download-models": "pnpm --silent --filter @pva/stt-sherpa download-models && pnpm --silent --filter @pva/tts-sherpa download",
    "check": "tsc -p tsconfig.json && tsc -p packages/protocol/tsconfig.json && pnpm --silent --filter @pva/web check && tsc -p docs/research/visualiser-investigation/lab/tsconfig.json",
    "test": "vitest run",
    "lab": "node docs/research/visualiser-investigation/lab/build.mjs",
    "lab:watch": "node docs/research/visualiser-investigation/lab/build.mjs --watch",
    "lab:shot": "node docs/research/visualiser-investigation/lab/shot.mjs",
    "dev": "pnpm --parallel --filter @pva/web --filter @pva/assistant dev",
    "e2e": "pnpm --filter @pva/web e2e",
    "e2e:real": "pnpm --filter @pva/web e2e:real",
    "bench:browser": "pnpm --filter @pva/web bench:browser"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "effect": "catalog:",
    "semver": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
