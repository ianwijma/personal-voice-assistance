    "@pva/core": "workspace:*",
    "@pva/protocol": "workspace:*",
    "effect": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
