{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "files": ["worklets/globals.d.ts"],
  "include": ["next-env.d.ts", "src", "test", "e2e", "e2e-real", "vitest.config.ts", "playwright.config.ts", "playwright.real.config.ts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "worklets", "mock", "out", "out-e2e", "public"]
}
