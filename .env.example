# Everything else is set in the web UI (pnpm serve → Settings). These are read before the UI exists.
# Copy to .env (git-ignored) only if you need one of them; the defaults suit most setups.
# A setting you find in an old .env can be moved into the UI: Settings → Diagnostics → Settings from outside → Move.
# PVA_ADMIN_PASSWORD=        # at least 8 characters; the admin page (/admin/) logs in with it. Unset: nothing can be configured from a browser
# PVA_VAULT_PASSWORD=        # unlock the key vault at startup; without it, unlock it in the UI after each restart
# PVA_DATA_DIR=              # settings and recordings; default <repo>/data
# SERVE_HOST=127.0.0.1       # anything else exposes the assistant to your network
# SERVE_PORT=8787
# SERVE_ALLOWED_HOSTS=        # host names it answers to besides IP addresses and localhost (e.g. assistant.lan)
# SERVE_TLS_CERT=            # both set: HTTPS (needed for the microphone off localhost)
# SERVE_TLS_KEY=
# SERVE_CROSS_ORIGIN_ISOLATION=true  # false only if the page fails to load on some browser
