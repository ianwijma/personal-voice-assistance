# Copy to .env (git-ignored) and fill in what you need. The app loads .env from
# the directory you run it in and from the repository root; variables already
# set in the environment win. Every value shown is the default, so the lines are
# commented out: uncomment only what you change. A variable set here also wins
# over the web UI (serve mode) and locks that field there ("Set by NAME in the
# environment"); leave it unset to change it from the UI instead.
#
# Everything runs on this machine except the language model. Download the local
# models once with
#   pnpm download-models
#
# API keys do NOT go here. Enter them in the web UI (pnpm start serve → Options):
# they are kept in an encrypted key vault outside this project (PVA_VAULT_PATH),
# unlocked with your password after each start. A key set here still works, wins
# over the vault and is shown as "set in .env (not protected)": anything that can
# read this folder (including coding agents working on it) can read it. The one
# secret that may live here is PVA_VAULT_PASSWORD (see "Key vault" below).

# --- Provider selection (only the selected providers' settings are read) ------
# fake = offline stand-in (answers time questions, echoes the rest) | anthropic (API key)
# | claude-subscription (the claude CLI logged in on this machine; switch on the
#   "Claude subscription" module and its opt-in under Options → Modules; counts
#   against your subscription's limits)
# LLM_PROVIDER=fake
# STT_PROVIDER=sherpa       # sherpa = local (sherpa-onnx) | deepgram = hosted
# TTS_PROVIDER=sherpa       # engine of the "standard" voice: sherpa = local (Piper/Kokoro) | cartesia = hosted
# pipewire = microphone/speaker via pw-record/pw-cat | file = WAV in, WAV files out
# AUDIO_BACKEND=pipewire

# --- Voices (declared in apps/assistant/src/voices.ts) ---------------------------
# The model picks a voice per reply with a [voice:NAME] marker. Only enabled
# voices are initialised (each local voice is its own engine process), so a
# disabled voice costs nothing and its API key is never needed.
#   standard    local Piper (TTS_PROVIDER), always enabled
#   natural     local Kokoro: warmer, slower to start (needs: pnpm --filter @pva/tts-sherpa download kokoro-af_heart)
#   expressive  hosted Cartesia (needs CARTESIA_API_KEY)
# VOICES=standard           # enabled voices, comma-separated, e.g. standard,natural,expressive
# DEFAULT_VOICE=standard    # voice for replies without a marker (always enabled)
# VOICE_<NAME>_PROVIDER=  # swap one voice's engine, e.g. VOICE_STANDARD_PROVIDER=cartesia
# Any provider setting can be set for one voice with a VOICE_<NAME>_ prefix; the
# unprefixed setting (including the API key) is the fallback. For example:
# VOICE_STANDARD_TTS_SHERPA_PRESET=nl_NL-pim-medium   # Dutch Piper voice
# VOICE_NATURAL_TTS_SHERPA_PRESET=kokoro-af_heart     # (the natural voice's built-in default)
# VOICE_EXPRESSIVE_CARTESIA_VOICE=   # a more expressive Cartesia voice id

# --- Local speech to text (STT_PROVIDER=sherpa) --------------------------------
# All of these except the directory and threads can also be set in the web UI (Options → Listening).
# parakeet-v2 (English, most accurate) | parakeet-ultra (+ Dutch and other European languages)
# | whisper-turbo (99 languages, slower) | hybrid-nemotron-parakeet (live words + Parakeet)
# | nemotron-560 | nemotron-320 (the previous default, was "nemotron-3.5") | zipformer-en | fast-conformer-en
# Download others with: pnpm --filter @pva/stt-sherpa download-models <preset>
# STT_SHERPA_MODEL=parakeet-v2
# STT_SHERPA_MODEL_DIR=           # default <repo>/models
# STT_SHERPA_THREADS=             # default: the preset's (Parakeet 8, Whisper 8, Nemotron 4, small ones 2)
# STT_SHERPA_LANGUAGE=auto        # Whisper and Nemotron: auto, en, nl, de, fr, ...; Parakeet ignores it
# STT_SHERPA_EAGER_SILENCE_MS=250   # silence before EagerEndOfTurn (the sentence is transcribed, a speculative reply starts)
# STT_SHERPA_FINAL_SILENCE_MS=600   # silence before EndOfTurn (the reply may play)
# STT_SHERPA_MIN_SPEECH_MS=100      # continuous speech before SpeechStarted / TurnResumed
# STT_SHERPA_VAD_THRESHOLD=0.5      # Silero speech probability (lower catches quiet speech but holds on longer after you stop)
# STT_SHERPA_AGC=true               # boost quiet microphones before speech detection (never raises steady noise above -50 dBFS)
# STT_SHERPA_AGC_MAX_GAIN_DB=30     # the most the gain control may add

# --- What the assistant hears (serve mode; also in Options → Listening) --------
# RECORD_HEARD_AUDIO=false          # save each turn's audio + levels to data/recordings/ (see README: "Is it the audio or the model?")
# RECORD_HEARD_AUDIO_MAX_FILES=50   # newest recordings kept

# --- Local text to speech (TTS_PROVIDER=sherpa) --------------------------------
# TTS_SHERPA_PRESET=en_US-lessac-medium  # en_US-lessac-medium | nl_NL-pim-medium | kokoro-af_heart
# TTS_SHERPA_MODEL_DIR=           # default <repo>/models
# TTS_SHERPA_THREADS=             # default: the preset's (Piper 4, Kokoro 8)
# TTS_SHERPA_SPEED=1
# TTS_SHERPA_TRIM_SILENCE=true      # trim clause edges and insert controlled pauses
# TTS_SHERPA_CLAUSE_PAUSE_MS=150    # pause after , ; :
# TTS_SHERPA_SENTENCE_PAUSE_MS=300  # pause after . ! ?
# TTS_SHERPA_PAD_MS=20
# TTS_SHERPA_CHUNK_MS=40

# --- Conversation --------------------------------------------------------------
# SYSTEM_PROMPT=          # default: a short "answer in one or two spoken sentences" prompt
# MAX_TOOL_ROUNDS=5         # tool rounds per turn before the turn is ended
# BARGE_IN=true             # stop talking when the user starts speaking (needs echo cancellation on open speakers)

# --- Anthropic (LLM_PROVIDER=anthropic) ----------------------------------------
# The API key is entered in the web UI (Options → Assistant → Language model) and kept in the key vault.
# ANTHROPIC_API_KEY=        # works, but unprotected: prefer the UI
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_EFFORT=low      # low | medium | high
# ANTHROPIC_THINKING=disabled  # disabled | adaptive (A/B tests only)
# ANTHROPIC_TIMEOUT_MS=5000 # fail when no headers / stream event arrive for this long
# ANTHROPIC_WARM_UP=true    # open the HTTPS connection at startup
# ANTHROPIC_BASE_URL=     # read by the SDK; default https://api.anthropic.com

# ===== Hosted providers (optional; only read when selected) =====================

# --- Deepgram Flux (STT_PROVIDER=deepgram) -------------------------------------
# DEEPGRAM_API_KEY=         # enter it in the UI (Options → Assistant → Speech engines) instead
# DEEPGRAM_MODEL=flux-general-en
# DEEPGRAM_EOT_THRESHOLD=0.7        # end-of-turn confidence, 0.5-1.0
# DEEPGRAM_EAGER_EOT_THRESHOLD=0.5  # eager end-of-turn (speculative replies), 0.3-0.9; 0 disables
# DEEPGRAM_EOT_TIMEOUT_MS=5000      # silence that ends a turn regardless of confidence
# DEEPGRAM_URL=wss://api.deepgram.com/v2/listen

# --- Cartesia Sonic (TTS_PROVIDER=cartesia) ------------------------------------
# CARTESIA_API_KEY=         # enter it in the UI (Options → Assistant → Speech engines) instead
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4  # "Skylar" (en-US)
# CARTESIA_LANGUAGE=en
# CARTESIA_SAMPLE_RATE=24000        # output Hz
# CARTESIA_MAX_BUFFER_DELAY_MS=0    # server-side text buffering; 0 = start at once
# CARTESIA_URL=wss://api.cartesia.ai

# --- PipeWire (AUDIO_BACKEND=pipewire) -----------------------------------------
# PIPEWIRE_CAPTURE_TARGET=        # node.name of the source, e.g. pva-echo-cancel-source (default: PipeWire's choice)
# PIPEWIRE_PLAYBACK_TARGET=       # node.name of the sink, e.g. pva-echo-cancel-sink
# PIPEWIRE_CAPTURE_LATENCY_MS=20
# PIPEWIRE_PLAYBACK_LATENCY_MS=20

# --- File audio (AUDIO_BACKEND=file, voice mode) -------------------------------
# AUDIO_INPUT_FILE=               # required: 16 kHz 16-bit WAV (or raw .pcm) played as the microphone
# AUDIO_INPUT_TRAILING_SILENCE_MS=3000  # silence after the file so the turn detector fires (also used by `transcribe`)
# AUDIO_OUTPUT_DIR=audio-out        # replies are written here as reply-001.wav, ...

# --- Web UI (serve mode: pnpm start serve) -------------------------------------
# SERVE_HOST=127.0.0.1            # bind address. Anything but loopback lets anyone who can reach the port use the
#                                 # assistant and change its settings (no login); prefer an SSH tunnel (README)
# SERVE_PORT=8787
# SERVE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # other page origins allowed to open the WebSocket (the dev server)
# SERVE_TLS_CERT=                 # PEM certificate and key: with both set, the server speaks HTTPS/WSS on the same port
# SERVE_TLS_KEY=                  # (browsers allow the microphone only on https:// or localhost)
# PVA_WEB_DIR=                    # the built UI; default <repo>/apps/web/out
# PVA_DATA_DIR=                   # settings saved from the UI (settings.json); default <repo>/data

# --- Key vault (serve mode) ------------------------------------------------------
# API keys and tokens entered in the UI live in one encrypted file (scrypt + AES-256-GCM), outside the project.
# It is unlocked with your password after every start (Options → Keys & access); typing it on a page also lets
# that page change keys, providers and agents. Forgot the password? Delete the file: the keys in it are lost.
# PVA_VAULT_PATH=                 # default $XDG_CONFIG_HOME/pva/vault.enc, else ~/.config/pva/vault.enc
# PVA_VAULT_PASSWORD=             # optional, the one secret that may live here: unlocks the vault at start so the
#                                 # assistant runs unattended. It never gives a page edit access (type it in the UI
#                                 # for that), is never logged, and is not passed to Claude Code or engine processes.

# --- Modules (also configurable in the web UI under Options) ----------------------
# CLAUDE_SUBSCRIPTION_OPT_IN=false  # the Claude subscription module's opt-in (better: switch it on in the UI)
# CLOCK_TIME_ZONE=                # IANA zone for the clock, e.g. Europe/Amsterdam; default: this machine's
# WEATHER_DEFAULT_PLACE=          # used when the user does not name a place, e.g. "Amsterdam, Netherlands"
# WEATHER_UNITS=celsius             # celsius (km/h) | fahrenheit (mph)

# --- Benchmarks ------------------------------------------------------------------
# BENCH_ROUNDS=3                    # offline: times the scripted conversation is repeated
# BENCH_LLM_FIRST_TOKEN_MS=250      # simulated LLM delays: offline "realistic" scenario, the fake LLM in bench --live, and (when set) the fake LLM in every other mode, e.g. serve
# BENCH_LLM_TOKENS_PER_S=60
# BENCH_TTS_FIRST_AUDIO_MS=150
# BENCH_EAGER_LEAD_MS=200           # how long before EndOfTurn the EagerEndOfTurn arrives
# BENCH_PLAYBACK_MS_PER_CLAUSE=200  # simulated playback time per clause (does not affect the headline number)
# BENCH_OUTPUT_DIR=bench-out        # live: replies are written here
